rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function admin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == "user"
        && request.resource.data.email == request.auth.token.email;
      allow read: if signedIn() && (request.auth.uid == userId || admin());
      allow update: if admin() || (signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.email == resource.data.email);
      allow delete: if admin() && request.auth.uid != userId;
    }

    match /users/{userId}/attempts/{attemptId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.userId == userId;
      allow read: if signedIn() && (request.auth.uid == userId || admin());
      allow update, delete: if admin();
    }

    match /exams/{document=**} {
      allow read: if signedIn();
      allow write: if admin();
    }

    match /leaderboard/{packageId}/results/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.userId == userId;
      allow delete: if admin();
    }

    match /feedback/{feedbackId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == "new"
        && request.resource.data.reply == ""
        && request.resource.data.type in ["suggestion", "criticism", "bug", "other"]
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 4
        && request.resource.data.title.size() <= 80
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 1500;
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || admin());
      allow update: if admin()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if admin();
    }

    match /settings/weeklyTryout {
      allow read, write: if admin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

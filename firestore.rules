rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function admin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == "user"
        && request.resource.data.email == request.auth.token.email;
      allow read: if signedIn() && (request.auth.uid == userId || admin());
      allow update: if admin() || (signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.email == resource.data.email);
      allow delete: if admin() && request.auth.uid != userId;
    }

    match /users/{userId}/attempts/{attemptId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.userId == userId;
      allow read: if signedIn() && (request.auth.uid == userId || admin());
      allow update, delete: if admin();
    }

    match /exams/{document=**} {
      allow read: if signedIn();
      allow write: if admin();
    }

    match /leaderboard/{packageId}/results/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.userId == userId;
      allow delete: if admin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
